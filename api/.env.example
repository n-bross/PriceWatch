# Loaded with: uv run uvicorn pricewatch_api.main:app --env-file .env
DATABASE_URL=sqlite:///./pricewatch.db
# Generate a long random token; required only for write endpoints.
PRICEWATCH_INGEST_KEY=
PRICEWATCH_FLYER_DIR=./data/flyers
PRICEWATCH_RECEIPT_DIR=./data/receipts
PRICEWATCH_DEFAULT_POSTAL_CODE=85567
PRICEWATCH_CATALOG_DIR=./data/catalog
# Supabase direct/session PostgreSQL URL also supported:
# DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/postgres?sslmode=require
