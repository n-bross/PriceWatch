[Unit]
Description=myTime price listings and barcode enrichment
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@API_DIR@
EnvironmentFile=@API_DIR@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@API_DIR@/.venv/bin/python scripts/sync_expanded_feeds.py listing --max-pages 50 --workers 2 --delay 0.5
ExecStart=@API_DIR@/.venv/bin/python scripts/sync_expanded_feeds.py enrich --max-details 100 --workers 2 --delay 0.5
TimeoutStartSec=840
Nice=10
UMask=0077
