[Unit]
Description=Import market-specific REWE pickup observations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@API_DIR@
EnvironmentFile=@API_DIR@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@API_DIR@/.venv/bin/python -m pricewatch_api.rewe_recurring --market-id ${REWE_MARKET_ID} --postal-code ${REWE_POSTAL_CODE}
TimeoutStartSec=840
Nice=10
UMask=0077
